# Example environment variables - DO NOT use in production!
# Copy this file to srcs/.env and update with secure values

# Domain Configuration
DOMAIN_NAME=macauchy.42.fr

# WordPress Site Metadata
WORDPRESS_SITE_URL=https://macauchy.42.fr
WORDPRESS_TITLE="Inception WordPress"

# MySQL/MariaDB Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change_this_wp_password

# WordPress Configuration
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=change_this_wp_password
WORDPRESS_DB_NAME=wordpress

# WordPress Users (administrator username must NOT contain "admin")
WORDPRESS_ADMIN_USER=wpowner
WORDPRESS_ADMIN_PASSWORD=change_this_admin_password
WORDPRESS_ADMIN_EMAIL=wpowner@example.com

WORDPRESS_SECONDARY_USER=wpeditor
WORDPRESS_SECONDARY_USER_PASSWORD=change_this_editor_password
WORDPRESS_SECONDARY_USER_EMAIL=wpeditor@example.com

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=change_this_redis_password

# FTP Configuration
FTP_USER=ftpuser
FTP_PASS=change_this_ftp_password
